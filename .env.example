# Local LLM via Ollama (optional — enhances conversation, still free & open source)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Wake word sensitivity (0.0 - 1.0)
JARVIS_WAKE_SENSITIVITY=0.6

# Default alert thresholds (overridable in Settings UI)
JARVIS_ALERT_CPU=90
JARVIS_ALERT_MEMORY=90
JARVIS_ALERT_DISK=95
JARVIS_ALERT_TEMP=85
