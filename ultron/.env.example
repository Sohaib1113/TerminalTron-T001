# Database
DATABASE_URL="file:./ultron.db"

# Server Configuration
BACKEND_PORT=5000
NODE_ENV=development

# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=

# JWT/Auth (for future use)
JWT_SECRET=your-secret-key-here-change-in-production

# Monitoring
ENABLE_MONITORING=true
MONITORING_INTERVAL=5000

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/ultron.log
