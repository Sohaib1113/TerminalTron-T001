# Dependencies
node_modules/

# Environment / secrets (never commit real keys)
.env
.env.*
!.env.example

# Logs and runtime data
logs/
*.log
*.err
*.pid
*.seed
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build info
*.tsbuildinfo

# Local speech-to-text binaries (large, not committed)
vendor/

# The whole vendor/ tree above already excludes the bundled Ollama runtime and
# model store (ultron/vendor/ollama/). Seed them with `npm run ollama:prepare`.

# Local databases
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite

# Build output
dist/
build/
out/
release/app/dist
release/build
.esbuild
coverage/
.eslintcache

# Cached webpack dll output
.erb/dll/

# Generated type declarations
*.css.d.ts
*.sass.d.ts
*.scss.d.ts

# Editor and OS metadata
.idea/
.DS_Store
Thumbs.db
